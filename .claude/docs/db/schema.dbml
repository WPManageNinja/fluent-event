// Event = CPT hybrid (wp_posts + wp_postmeta + wp_fevents_events). Classification = WP taxonomies.

Table wp_fevents_calendars {
  id bigint [primary key, increment]
  title varchar [not null]
  slug varchar [unique, not null]
  description text
  logo_url varchar
  cover_url varchar
  visibility varchar [not null]
  settings json
  status varchar [not null]
  created_by bigint [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    slug [name: 'uq_calendars_slug', unique]
    visibility [name: 'idx_calendar_visibility']
    status [name: 'idx_calendar_status']
  }
}

Table wp_fevents_meta {
  id bigint [primary key, increment]
  object_type varchar [not null]
  object_id bigint
  meta_key varchar [not null]
  value longtext
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (object_type, object_id, meta_key) [name: 'idx_meta_lookup']
  }
}

Table wp_fevents_notifications {
  id bigint [primary key, increment]
  user_id bigint
  action varchar [not null]
  object_type varchar
  object_id bigint
  title varchar
  content text
  route text
  created_at timestamp [not null]
  indexes {
    (object_type, object_id) [name: 'idx_notif_object']
    action [name: 'idx_notif_action']
  }
}

Table wp_fevents_notification_users {
  id bigint [primary key, increment]
  object_type varchar [not null]
  notification_type varchar [not null]
  object_id bigint [not null]
  user_id bigint [not null]
  is_read tinyint [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (user_id, object_type, object_id, notification_type) [name: 'uq_notif_user', unique]
    (user_id, is_read, object_type) [name: 'idx_notif_user_inbox']
    (object_id, is_read, object_type, notification_type) [name: 'idx_notif_user_object']
  }
}

Table wp_fevents_events {
  id bigint [primary key, increment]
  post_id bigint [unique, not null]
  status varchar [not null]
  start_at datetime [not null]
  end_at datetime [not null]
  timezone varchar [not null]
  calendar_id bigint [not null, ref: > wp_fevents_calendars.id]
  parent_event_id bigint [ref: > wp_fevents_events.id]
  venue_type varchar [not null]
  currency varchar
  settings json
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    post_id [name: 'uq_events_post', unique]
    status [name: 'idx_event_status']
    (start_at, end_at) [name: 'idx_event_window']
  }
}

Table wp_fevents_ticket_types {
  id bigint [primary key, increment]
  event_id bigint [not null, ref: > wp_fevents_events.id]
  type varchar [not null]
  description varchar
  price decimal [not null]
  capacity int
  sold int [not null]
  min_per_reg int [not null]
  max_per_reg int
  sale_start_at datetime
  sale_end_at datetime
  status varchar [not null]
  sort_order int [not null]
  settings json
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (event_id, status) [name: 'idx_ticket_event_status']
  }
}

Table wp_fevents_registrations {
  id bigint [primary key, increment]
  event_id bigint [not null, ref: > wp_fevents_events.id]
  buyer_name varchar [not null]
  buyer_email varchar [not null]
  buyer_phone varchar
  tickets int [not null]
  status varchar [not null]
  payment_status varchar [not null]
  payment_ref varchar
  total_amount decimal [not null]
  paid_at datetime
  source varchar [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (event_id, status) [name: 'idx_reg_event_status']
    buyer_email [name: 'idx_reg_email']
  }
}

Table wp_fevents_guests {
  id bigint [primary key, increment]
  event_id bigint [not null, ref: > wp_fevents_events.id]
  registration_id bigint [not null, ref: > wp_fevents_registrations.id]
  ticket_type_id bigint [not null, ref: > wp_fevents_ticket_types.id]
  name varchar
  email varchar
  phone varchar
  status varchar [not null]
  form_response json
  ticket_code varchar [unique]
  checked_in_at datetime
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    ticket_code [name: 'uq_guests_ticket_code', unique]
    (event_id, status) [name: 'idx_guest_event_status']
  }
}

// Taxonomies (WP-native, registered on post_type fevents_event):
//   fevents_event_type (hierarchical) — category/type of event; term meta: fevents_color, fevents_icon_id
//   fevents_venue (hierarchical) — where (view-only place); term meta: fevents_address, fevents_city, fevents_map_url, fevents_lat, fevents_lng
//   fevents_organizer (hierarchical) — who runs it (reusable across events); term meta: fevents_email, fevents_phone, fevents_website, fevents_social, fevents_logo_id
//   fevents_performer (flat) — speaker/artist (thin: name + photo, no profile page); term meta: fevents_photo_id, fevents_designation, fevents_social

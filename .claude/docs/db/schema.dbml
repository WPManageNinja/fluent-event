// Fluent Events — Database Schema (DBML for dbdiagram.io). Generated — do not hand-edit.
// 9 plugin tables + WP core stubs. Ticketing + roster + WP-native media/identity.

Table wp_users {
  ID bigint [primary key, increment]
  user_login varchar [not null]
  user_email varchar [not null]
  display_name varchar [not null]
}

Table wp_posts {
  id bigint [primary key, increment]
}

Table wp_fevents_meta {
  id bigint [primary key, increment]
  object_type varchar [not null]
  object_id bigint
  meta_key varchar [not null]
  value longtext
  created_at timestamp
  updated_at timestamp
  indexes {
    (object_type, object_id, meta_key) [name: 'idx_meta_lookup']
  }
}

Table wp_fevents_calendars {
  id bigint [primary key, increment]
  name varchar [not null]
  slug varchar [not null, unique]
  description text
  logo_media_id bigint [ref: > wp_posts.id]
  cover_media_id bigint [ref: > wp_posts.id]
  visibility varchar [not null]
  settings json
  status varchar [not null]
  created_by bigint [not null, ref: > wp_users.ID]
  created_at timestamp
  updated_at timestamp
  indexes {
    visibility [name: 'idx_calendar_visibility']
    status [name: 'idx_calendar_status']
  }
}

Table wp_fevents_events {
  id bigint [primary key, increment]
  title varchar [not null]
  slug varchar [not null, unique]
  description longtext
  status varchar [not null]
  visibility varchar [not null]
  start_at datetime [not null]
  end_at datetime [not null]
  timezone varchar [not null]
  calendar_id bigint [not null, ref: > wp_fevents_calendars.id]
  parent_event_id bigint [ref: > wp_fevents_events.id]
  venue_type varchar [not null]
  address varchar
  lat decimal
  lon decimal
  online_meeting_url varchar
  join_policy varchar [not null]
  waitlist_enabled tinyint [not null]
  created_by bigint [not null, ref: > wp_users.ID]
  cover_image_id bigint [ref: > wp_posts.id]
  currency varchar
  form_fields json
  settings json
  created_at timestamp
  updated_at timestamp
  indexes {
    (status, visibility) [name: 'idx_event_state']
    (start_at, end_at) [name: 'idx_event_window']
  }
}

Table wp_fevents_ticket_types {
  id bigint [primary key, increment]
  event_id bigint [not null, ref: > wp_fevents_events.id]
  type varchar [not null]
  description varchar
  price decimal [not null]
  capacity int
  sold int [not null]
  min_per_reg int [not null]
  max_per_reg int
  sale_start_at datetime
  sale_end_at datetime
  status varchar [not null]
  sort_order int [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (event_id, status) [name: 'idx_ticket_event_status']
  }
}

Table wp_fevents_registrations {
  id bigint [primary key, increment]
  event_id bigint [not null, ref: > wp_fevents_events.id]
  buyer_name varchar [not null]
  buyer_email varchar [not null]
  buyer_phone varchar
  tickets int [not null]
  status varchar [not null]
  payment_status varchar [not null]
  payment_ref varchar
  total_amount decimal [not null]
  paid_at datetime
  source varchar [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (event_id, status) [name: 'idx_reg_event_status']
    buyer_email [name: 'idx_reg_email']
  }
}

Table wp_fevents_guests {
  id bigint [primary key, increment]
  event_id bigint [not null, ref: > wp_fevents_events.id]
  registration_id bigint [not null, ref: > wp_fevents_registrations.id]
  ticket_type_id bigint [not null, ref: > wp_fevents_ticket_types.id]
  name varchar
  email varchar
  phone varchar
  status varchar [not null]
  form_response json
  ticket_code varchar [unique]
  checked_in_at datetime
  created_at timestamp
  updated_at timestamp
  indexes {
    (event_id, status) [name: 'idx_guest_event_status']
  }
}

Table wp_fevents_sponsors {
  id bigint [primary key, increment]
  event_id bigint [not null, ref: > wp_fevents_events.id]
  name varchar [not null]
  logo_id bigint [ref: > wp_posts.id]
  website varchar
  type varchar
  amount decimal
  sort_order int [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (event_id, type) [name: 'idx_sponsor_event_type']
  }
}

Table wp_fevents_people {
  id bigint [primary key, increment]
  event_id bigint [not null, ref: > wp_fevents_events.id]
  type varchar [not null]
  name varchar [not null]
  designation varchar
  is_primary tinyint [not null]
  photo_id bigint [ref: > wp_posts.id]
  links json
  sort_order int [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (event_id, type) [name: 'idx_people_event_type']
  }
}

Table wp_fevents_notifications {
  id bigint [primary key, increment]
  recipient_id bigint [not null, ref: > wp_users.ID]
  actor_id bigint [ref: > wp_users.ID]
  action varchar [not null]
  object_type varchar
  object_id bigint
  title varchar
  content text
  route text
  read_at datetime
  created_at timestamp
  indexes {
    (recipient_id, action, object_id) [unique, name: 'uq_notification']
    (recipient_id, read_at) [name: 'idx_notif_recipient']
    (object_type, object_id) [name: 'idx_notif_object']
    action [name: 'idx_notif_action']
  }
}

{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash .claude/hooks/git-rules.sh",
						"statusMessage": "Checking git rules…"
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/coding-rules-inject.sh",
						"statusMessage": "Loading coding rules…"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/coding-rules-scan.sh"
					}
				]
			}
		]
	}
}

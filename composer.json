{
    "name": "wpfluent/fluent-event",
    "type": "project",
    "description": "FluentEvent events plugin for WordPress.",
    "keywords": [
        "WordPress",
        "framework",
        "WPFluent"
    ],
    "license": "GPL-2.0-or-later",
    "version": "2.5.1",
    "authors": [
        {
            "name": "WPManageNinja LLC",
            "homepage": "https://wpmanageninja.com/"
        }
    ],
    "config": {
        "platform": {
            "php": "7.4"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/wpfluent/framework2x",
            "canonical": false
        },
        {
            "type": "vcs",
            "url": "https://github.com/wpfluent/framework3x",
            "canonical": false
        }
    ],
    "require": {
        "wpfluent/framework": "^2.0",
        "woocommerce/action-scheduler": "4.2.0"
    },
    "autoload": {
        "psr-4": {
            "FluentEvent\\App\\": "app/",
            "FluentEvent\\Modules\\": "Modules/",
            "FluentEvent\\Dev\\": "dev/"
        },
        "classmap": [
            "database/"
        ],
        "files": []
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        },
        "wpfluent": {
            "namespace": {
                "current": "FluentEvent"
            },
            "excludes": [
                "*"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "FluentEvent\\Dev\\ComposerScript::run"
        ],
        "post-update-cmd": [
            "FluentEvent\\Dev\\ComposerScript::run"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

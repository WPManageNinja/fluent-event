{
    "scripts": {
        "dev": "node resources/vite/vite.js && vite",
        "watch": "npm run dev",
        "build": "node resources/vite/vite.js --build && vite build",
        "production": "npm run build",
        "prod": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:php": "tests/vendor/bin/phpunit --no-coverage",
        "test:integration": "FE_INTEGRATION=1 php -d memory_limit=1G tests/vendor/bin/phpunit -c phpunit.integration.xml",
        "test:all": "npm test && npm run test:php"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.0.9",
        "echarts": "5.6.0",
        "element-plus": "^2.2.17",
        "lodash": "^4.17.21",
        "vue": "3.5.44",
        "vue-router": "^4.1.5"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^4.3.4",
        "@vue/compiler-sfc": "3.5.44",
        "@vue/test-utils": "2.4.11",
        "glob": "^10.3.4",
        "happy-dom": "20.14.5",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.93.2",
        "sass-loader": "^13.0.2",
        "unplugin-auto-import": "^0.11.2",
        "unplugin-vue-components": "^0.22.7",
        "vite": "^4.4.9",
        "vite-plugin-live-reload": "^3.0.2",
        "vite-plugin-static-copy": "^0.16.0",
        "vitest": "0.34.6",
        "vue-loader": "^17.0.0"
    }
}
